# /srv/finerp/env/<slug>.env — the app's environment for ONE tenant.
# Real files live only on the server: /srv/finerp/env (chmod 700), each file
# chmod 600. Never commit a filled-in copy. ops/new-franchise.sh fills this
# template for new franchises.
#
# Docker reads this file literally: no quotes around values, no `export`,
# no inline comments after a value.

# --- Database (Neon) -------------------------------------------------------
# The Neon DIRECT host — never one containing `-pooler`. The nightly job takes
# a session-level advisory lock that PgBouncer transaction pooling breaks.
DB_HOST=ep-example-123456.ap-southeast-1.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=change-me

# --- Auth ------------------------------------------------------------------
# Unique per tenant: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# main keeps old prod's key so nobody is logged out at cutover.
SECRET_KEY=change-me
ALGORITHM=HS256

# --- Documents (S3) --------------------------------------------------------
# The S3 region, not the server's: buckets stay in Mumbai (ap-south-1).
# Credentials come from the instance role (IMDSv2 hop limit 2), not this file.
AWS_REGION=ap-south-1
# main: finance-erp-docs-uat, dev: finance-erp-docs-dev,
# franchises: finerp-docs-<slug>
S3_BUCKET_NAME=finerp-docs-example

# --- CORS ------------------------------------------------------------------
# Comma-separated exact origins of the frontend for this tenant.
CORS_ORIGINS=https://example.sriadithyafinance.loan
# Extra origins by regex. Leave this line commented out while Vercel still
# serves the frontend (the built-in default allows the two vercel.app
# projects); set it to empty (CORS_ORIGIN_REGEX=) once Vercel is retired.
# CORS_ORIGIN_REGEX=

# --- Client IPs behind cloudflared + Docker --------------------------------
# The app sees the Docker bridge as the peer; trust exactly one hop of
# X-Forwarded-For (the entry Cloudflare appends). Required for per-user
# rate limits and correct audit-log IPs.
TRUST_FORWARDED_FOR=true
TRUSTED_PROXY_HOPS=1

# --- Nightly job (IST) -----------------------------------------------------
# Stagger NIGHTLY_JOB_MINUTE across tenants so jobs on the shared server do
# not all start at once.
NIGHTLY_JOB_HOUR=3
NIGHTLY_JOB_MINUTE=0

# --- Branding defaults -----------------------------------------------------
# Used until a SUPER_ADMIN saves the names in Settings (org_settings row).
ORG_DISPLAY_NAME=Sri Adithya Finance – Example
ORG_SHORT_NAME=Example
